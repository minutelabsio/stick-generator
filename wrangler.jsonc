{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stick-generator",
  "main": "api/index.ts",
  "account_id": "847aff3ed9c07c12eae4f4747ae61e8b",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Workers Logs: view in the dashboard or stream with `wrangler tail`.
  // Inheritable, so it applies to every environment below.
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  },

  // Bindings and vars are NOT inherited, so every environment declares its own.
  // dev and test run locally only (miniflare), so their resource IDs are placeholders.
  "env": {
    "dev": {
      "vars": {
        "ACCESS_TEAM_DOMAIN": "dev.invalid",
        "ACCESS_AUD": "dev",
        // Only the dev environment may skip Access. Every request is treated as this user.
        "ACCESS_DEV_BYPASS_EMAIL": "designer@example.com"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "stick-generator-dev", "database_id": "local-dev", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "ASSET_BUCKET", "bucket_name": "stick-figures-assets-dev" },
        { "binding": "FIGURE_BUCKET", "bucket_name": "stick-figures-dev" }
      ]
    },

    "test": {
      "vars": {
        "ACCESS_TEAM_DOMAIN": "test.cloudflareaccess.com",
        "ACCESS_AUD": "test-audience"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "stick-generator-test", "database_id": "local-test", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "ASSET_BUCKET", "bucket_name": "stick-figures-assets-test" },
        { "binding": "FIGURE_BUCKET", "bucket_name": "stick-figures-test" }
      ]
    },

    "staging": {
      "routes": [{ "pattern": "stick-generator-staging.neptunestudios.info", "custom_domain": true }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "minuteearth.cloudflareaccess.com",
        "ACCESS_AUD": "237b4516f595148917cfcd4fd0f9404b9651c1afdbefdb471bac23ccf0736aa8"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "stick-generator-staging", "database_id": "1bd39783-d5ee-466c-9fbc-43d994524128", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "ASSET_BUCKET", "bucket_name": "stick-figures-assets-staging" },
        { "binding": "FIGURE_BUCKET", "bucket_name": "stick-figures-staging" }
      ]
    },

    // The buckets are the existing v1 buckets; v2 writes only under the v2/ prefix.
    "production": {
      "routes": [{ "pattern": "stick-generator.neptunestudios.info", "custom_domain": true }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "minuteearth.cloudflareaccess.com",
        "ACCESS_AUD": "342ad50c0727f6c71d5a1b551c358b1817083983d7ffa650d9ea6b7a73442ba0"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "stick-generator-production", "database_id": "47baa519-621c-49ec-a3dd-8731df29c5e9", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "ASSET_BUCKET", "bucket_name": "stick-figures-assets" },
        { "binding": "FIGURE_BUCKET", "bucket_name": "stick-figures" }
      ]
    }
  }
}
