{
  "name": "stick-generator",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wrangler:types": "wrangler types --env production --strict-vars=false",
    "dev": "bun run wrangler:types && CLOUDFLARE_ENV=dev vite dev",
    "dev:init": "bun run db:migrate:local && bun run db:seed:local",
    "build": "bun run wrangler:types && vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run wrangler:types && vue-tsc --build",
    "test": "CLOUDFLARE_ENV=test vitest run",
    "test:watch": "CLOUDFLARE_ENV=test vitest",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:migrate:local": "wrangler d1 migrations apply DB --env dev --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "db:seed:local": "wrangler d1 execute DB --env dev --local --file=./scripts/seed-dev.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@primeuix/themes": "^3.0.1",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.137.0"
  }
}
